# 本地开发配置示例。不要把真实值提交到 Git。
EXAM_DB_PASSWORD=your-postgres-password
REDIS_STACK_HOST=localhost
REDIS_STACK_PORT=6378
REDIS_STACK_PASSWORD=your-redis-password
ZHIPUAI_API_KEY=your-zhipu-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
# 多个来源用逗号分隔；网关域名用于 OAuth2 原生登录表单，null 用于部分浏览器的跨站重定向表单来源。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:7049,null
ROCKETMQ_ENABLED=false
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
SEATA_ENABLED=false
EXAM_WEBSOCKET_ENABLED=true
